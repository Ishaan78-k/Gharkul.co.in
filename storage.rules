rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{folder}/{file} {
      allow read: if folder in ['properties', 'announcements'];
      allow create, update: if folder in ['properties', 'announcements']
        && request.auth != null && request.auth.token.owner == true
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
      allow delete: if request.auth != null && request.auth.token.owner == true;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
